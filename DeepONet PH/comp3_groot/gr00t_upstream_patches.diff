diff --git a/gr00t/model/gr00t_n1d6/gr00t_n1d6.py b/gr00t/model/gr00t_n1d6/gr00t_n1d6.py
index db5c5af..8a61861 100755
--- a/gr00t/model/gr00t_n1d6/gr00t_n1d6.py
+++ b/gr00t/model/gr00t_n1d6/gr00t_n1d6.py
@@ -414,6 +414,42 @@ class Gr00tN1d6(PreTrainedModel):
     config_class = Gr00tN1d6Config
     supports_gradient_checkpointing = True
 
+    def _init_weights(self, module):
+        """Initialize *newly added* params (e.g. the DeepONet action head) that are
+        absent from the pretrained checkpoint. Under from_pretrained fast-init these
+        modules are materialized on meta -> uninitialized garbage (~1e32) unless
+        initialized here. transformers calls this only for missing keys, so the loaded
+        backbone / stock diffusion head are untouched. No-op for the diffusion variant
+        (its head weights come from the checkpoint)."""
+        import torch.nn as nn
+        from .deeponet_head_v2 import CrossAttnPool, DeepONetHeadV2
+
+        if isinstance(module, nn.Linear):
+            nn.init.xavier_uniform_(module.weight)
+            if module.bias is not None:
+                nn.init.zeros_(module.bias)
+        elif isinstance(module, nn.LayerNorm):
+            nn.init.ones_(module.weight)
+            nn.init.zeros_(module.bias)
+        elif isinstance(module, nn.Embedding):
+            nn.init.normal_(module.weight, mean=0.0, std=0.02)
+        elif isinstance(module, nn.MultiheadAttention):
+            if module.in_proj_weight is not None:
+                nn.init.xavier_uniform_(module.in_proj_weight)
+            else:
+                for w in (module.q_proj_weight, module.k_proj_weight, module.v_proj_weight):
+                    if w is not None:
+                        nn.init.xavier_uniform_(w)
+            if module.in_proj_bias is not None:
+                nn.init.zeros_(module.in_proj_bias)
+            nn.init.xavier_uniform_(module.out_proj.weight)
+            if module.out_proj.bias is not None:
+                nn.init.zeros_(module.out_proj.bias)
+        elif isinstance(module, CrossAttnPool):
+            nn.init.normal_(module.queries, mean=0.0, std=0.02)
+        elif isinstance(module, DeepONetHeadV2):
+            nn.init.zeros_(module.out_bias)
+
     def __init__(
         self,
         config: Gr00tN1d6Config,
@@ -451,8 +487,20 @@ class Gr00tN1d6(PreTrainedModel):
             transformers_loading_kwargs=transformers_loading_kwargs,
         )
 
-        # Initialize action head
-        self.action_head = Gr00tN1d6ActionHead(config)
+        # Initialize action head. Env-driven swap for the SOTA comparison:
+        #   GR00T_ACTION_HEAD = diffusion (default) | deeponet | deeponet_ph
+        # Default keeps the stock flow-matching diffusion head byte-for-byte, so
+        # the baseline variant is completely unaffected by this hook.
+        import os as _os
+        _aht = _os.environ.get("GR00T_ACTION_HEAD", "diffusion")
+        if _aht in ("deeponet", "deeponet_ph"):
+            from .deeponet_action_head import Gr00tN1d6DeepONetActionHead
+            self.action_head = Gr00tN1d6DeepONetActionHead(config)
+            print(f"[GR00T] action head = {_aht} "
+                  f"(PH={_os.environ.get('GR00T_PH', '0')}, "
+                  f"lambda_ph={_os.environ.get('GR00T_LAMBDA_PH', '0.02')})")
+        else:
+            self.action_head = Gr00tN1d6ActionHead(config)
         from .processing_gr00t_n1d6 import Gr00tN1d6DataCollator
 
         self.collator = Gr00tN1d6DataCollator(
diff --git a/gr00t/model/modules/eagle_backbone.py b/gr00t/model/modules/eagle_backbone.py
index 6424dda..0102dca 100755
--- a/gr00t/model/modules/eagle_backbone.py
+++ b/gr00t/model/modules/eagle_backbone.py
@@ -44,6 +44,16 @@ class EagleBackbone(torch.nn.Module):
             assert load_bf16, "nvidia/Eagle-Block2A-2B-v2 requires bfloat16 by default"
             eagle_path = os.path.join(os.path.dirname(__file__), "nvidia", "Eagle-Block2A-2B-v2")
             config = AutoConfig.from_pretrained(eagle_path, trust_remote_code=True)
+            # EAGLE_ATTN lets us fall back off flash_attention_2 (which yields NaN backbone
+            # features under the drifted torch/flash-attn ABI) to sdpa/eager. Applied to the
+            # top config AND the vision/text sub-configs so it actually propagates.
+            _attn = os.environ.get("EAGLE_ATTN")
+            if _attn:
+                for _c in (config, getattr(config, "vision_config", None),
+                           getattr(config, "text_config", None)):
+                    if _c is not None:
+                        _c._attn_implementation = _attn
+                        _c.attn_implementation = _attn
             self.model = AutoModel.from_config(config, trust_remote_code=True)
         else:
             raise ValueError(f"Model {model_name} not supported")
